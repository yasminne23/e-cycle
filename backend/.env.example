#	============================================================
#	E-CYCLE	-	Variaveis	de	ambiente	do	backend
#	Copie	este	arquivo	para	".env"	e	preencha	com	os	seus	dados.
#	O	arquivo	.env	NAO	vai	para	o	Git	(esta	no	.gitignore).
#	============================================================
#	Porta	em	que	a	API	vai	rodar
PORT=3000
#	String	de	conexao	do	Supabase	(Postgres).
#	No	painel	do	Supabase:	Project	Settings	>	Database	>	Connection	string	>	URI.
#	Exemplo	(troque	pelos	seus	dados):
DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#	SSL	da	conexao.	Deixe	"true"	para	o	Supabase.
#	Use	"false"	apenas	se	for	testar	com	um	Postgres	LOCAL	sem	SSL.
DB_SSL=true
#	Numero	de	"rounds"	do	bcrypt	(custo	do	hash	da	senha)
BCRYPT_ROUNDS=10
#	Segredo	usado	para	assinar	os	tokens	JWT	(troque	por	um	valor	aleatorio).
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio
#	Tempo	de	expiracao	do	token
JWT_EXPIRA=8h